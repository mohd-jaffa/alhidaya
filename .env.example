# ─────────────────────────────────────────────────────────────
# Al Hidaya website: environment
#
# Copy to .env.local. Every value below is for this machine only: the local
# MySQL and Mailpit from compose.yaml (`npm run services:start`). Production
# values live in the cPanel Node.js app's environment, never in a file
# (plan §26.2). src/lib/env validates what the app reads (R0.6); later rows
# add their variables here as they arrive.
# ─────────────────────────────────────────────────────────────

# ── The site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: local MySQL 8.0.46 (Docker, port 56306) ────────
# The app connects with data rights only (plan §26.1).
DATABASE_URL=mysql://alhidaya_app:local-app@127.0.0.1:56306/alhidaya
# Migrations run with schema rights: drizzle.config.ts here, the release
# workflow in production.
MIGRATION_DATABASE_URL=mysql://alhidaya_migrator:local-migrator@127.0.0.1:56306/alhidaya

# ── Mail: local Mailpit (Docker; SMTP 56325, inbox http://127.0.0.1:56324) ──
# Production: the server's cPanel mail as noreply@alhidaya.qa (plan D53),
# over TLS, set in the cPanel Node.js app's environment (R8.3).
SMTP_HOST=127.0.0.1
SMTP_PORT=56325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Admin sign-in (plan §26.4) ──────────────────────────────
# Local values only. Production's are real secrets (`openssl rand -hex 32`),
# set once in the cPanel app's environment: a new BETTER_AUTH_SECRET signs the
# admin out; a new HASH_SECRET forgets the lockout and rate-limit counts.
BETTER_AUTH_SECRET=local-better-auth-secret-not-for-production
HASH_SECRET=local-hash-secret-not-for-production-use

# ── Turnstile: the forms' check that a person is sending (plan §10.3) ──
# Cloudflare's published test keys: the widget always passes, and so does the
# server's check. Production uses the site's own keys from the client's
# Cloudflare account, set in the cPanel app's environment (R8.4); never these.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Uploads (plan §9.4, §21.3) ──────────────────────────────
# Locally under the project (both git-ignored); the dev server serves
# public/media. On the server: MEDIA_DIR inside public_html (served by Apache),
# CV_DIR outside it (never served), both outside the release folders (R8.1).
MEDIA_DIR=public/media
MEDIA_URL=/media
CV_DIR=.data/cvs

# ── Tests: their own database ────────────────────────────────
# tests/support/local-database.ts refuses anything but a local MySQL.
TEST_DATABASE_URL=mysql://alhidaya_app:local-app@127.0.0.1:56306/alhidaya_test
TEST_MIGRATION_DATABASE_URL=mysql://alhidaya_migrator:local-migrator@127.0.0.1:56306/alhidaya_test
# Mailpit's API, where the integration tests read what was sent.
MAILPIT_URL=http://127.0.0.1:56324

# The kit preview page at /kit (plan D64): "true" locally and in the browser
# tests; never set in production.
KIT_PREVIEW=true

# The app serves the media folder at MEDIA_URL itself (the standalone build
# serves only what public/ held when it was built): "true" locally and in the
# browser tests; never in production, where Apache serves it (plan §21.3).
SERVE_MEDIA=true

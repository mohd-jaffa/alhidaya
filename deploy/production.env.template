# What only you can supply for the production site (docs/RELEASE.md section 3.2).
#
#   cp deploy/production.env.template .env.production      (the file is git-ignored by the .env* rule)
#   chmod 600 .env.production
#
# Fill in the three values below. Never paste them into chat, tickets or the repository. I read this file only to
# send these values to the server's Node.js app settings; I never print it. Everything else the production site
# needs (the database logins, the Better Auth secret, the IP-hash secret, the cron secret, the paths, the site
# address) I generate or set myself, on the server, without displaying it.

# Cloudflare Turnstile: the widget's hostnames must include alhidaya.qa, www.alhidaya.qa and preview.alhidaya.qa.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The NEW password of the mailbox noreply@alhidaya.qa (change it first in cPanel: the old one may be in the public zip).
SMTP_PASSWORD=

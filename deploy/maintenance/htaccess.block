# BEGIN MAINTENANCE (RELEASE.md section 6; added and removed by scripts/maintenance.sh)
# While this block is present every request answers HTTP 503 with the notice, except the notice itself and the
# SSL certificate challenges (so AutoSSL renewals keep working). Retry-After tells search engines the outage is
# short, so rankings are kept.
Options -Indexes
DirectoryIndex maintenance.html
ErrorDocument 503 /maintenance.html
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set Retry-After "3600"
  Header always set X-Robots-Tag "noindex"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$
  RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation)/
  RewriteRule ^ - [R=503,L]
</IfModule>
# END MAINTENANCE
